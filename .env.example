# Rename this file to ".env" and fill in your real values. Never commit ".env" to git.

# --- Optional local SQLite database path (defaults to backend/database/school.sqlite) ---
# SCHOOL_DB_PATH=/path/to/school.sqlite

# --- Optional shared PostgreSQL database / Neon (same URL for web and Electron) ---
# Configure the URL privately in Electron userData/settings.env for installed apps.
# SHARED_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# DB_DRIVER=postgres
# Set DB_DRIVER=sqlite for offline-first desktop use with optional Neon snapshot sync.

# --- Server ---
PORT=5000

# --- JWT (used to sign login tokens) ---
JWT_SECRET=replace_this_with_a_long_random_string

# --- Paystack (get these from your Paystack dashboard -> Settings -> API Keys) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional parent email notices (requires internet access) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=school@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=school@example.com

# --- School details (shown on report cards and the home page) ---
SCHOOL_NAME=Sunrise International School
SCHOOL_ADDRESS=123 Independence Avenue, Accra, Ghana
SCHOOL_PHONE=+233 20 000 0000
SCHOOL_EMAIL=
FINANCE_OFFICER_NAME=Finance Officer
ADMIN_WHATSAPP_NUMBER=233557801521
